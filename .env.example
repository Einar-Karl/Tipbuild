# --- Core ---
# Postgres connection string. Leave empty for local dev: an embedded Postgres (PGlite) is stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite
# Only for demos/e2e: allow the embedded DB + mock provider with NODE_ENV=production
ALLOW_LOCAL_DB=false
APP_URL=http://localhost:3000
# >= 32 random chars (openssl rand -hex 32). Signs sessions and mock webhooks.
AUTH_SECRET=
# Comma separated emails that get the admin role when they sign in
ADMIN_EMAILS=

# --- Money ---
# psp_scheduled_payout (default, compliant): payment provider holds funds, monthly payout schedule per guide.
# platform_pooled: platform holds funds and pays monthly. Regulated! Needs ALLOW_POOLED_FUNDS=true and legal sign-off.
FUNDS_MODEL=psp_scheduled_payout
ALLOW_POOLED_FUNDS=false
# Service fee in basis points (500 = 5%)
FEE_BPS=500
# Minimum monthly payout in minor units (2000 = EUR 20,00); below it the balance rolls over
MIN_PAYOUT_MINOR=2000
DEFAULT_CURRENCY=EUR
# Assumed annual interest rate for the float report (600 = 6%)
ASSUMED_RATE_BPS=600
# Static EUR->ISK rate used only for the price hint shown to tourists
ISK_PER_EUR=150

# --- Payment provider ---
# mock (default when no Stripe key) | stripe
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Email / jobs ---
RESEND_API_KEY=
EMAIL_FROM=Tip <tips@example.com>
# Protects /api/cron/* (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Free-text reviews older than this many months are purged by the retention job
RETENTION_MONTHS=24
